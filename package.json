{
  "name": "coro-billing",
  "version": "0.1.0",
  "private": true,
  "description": "MSP Hub — Coro billing automation. Usage in -> H (our cost) & L (partner price) applied -> per-customer breakdown -> QuickBooks invoices. Built to the spec in README.md; grounded in the Sep 11, 2026 call transcript.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "coro-billing": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cli": "tsx src/cli/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "decimal.js": "^10.4.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
